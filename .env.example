# OpenRouter APIキー（必須）
OPENROUTER_API_KEY=

# 公開VPSでは必須。未設定だと認証が無効（開発用）
APP_PASSWORD=

# セッション署名用のランダムな長い文字列
SESSION_SECRET=

# 既定モデル
DEFAULT_MODEL=anthropic/claude-opus-5
# 要約・抽出・判定用の軽量モデル
UTILITY_MODEL=anthropic/claude-sonnet-5

PORT=3000
DB_PATH=./data/app.sqlite
APP_URL=http://localhost:3000
APP_TITLE=Character Chat

# 認証Cookieに secure を付けるか。未設定なら APP_URL が https:// のときだけ有効
# COOKIE_SECURE=1

# リバースプロキシ配下で X-Forwarded-* を信頼する段数（nginx等の背後なら 1）
# TRUST_PROXY=1

# LLMのエンドポイント。既定はOpenRouter。テストでモックに向ける場合のみ設定する
# OPENROUTER_BASE_URL=http://localhost:4010/v1
