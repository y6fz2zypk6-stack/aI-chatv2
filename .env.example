# OpenRouter APIキー（必須）
OPENROUTER_API_KEY=

# 公開VPSでは必須。未設定だと認証が無効（開発用）
APP_PASSWORD=

# ログインパスワードの比較に使うHMAC鍵（ランダムな長い文字列）。
# 入力値と期待値を同じ長さのHMACにしてから timingSafeEqual で比べるためのもの。
# 未設定なら APP_PASSWORD を代用する。セッションIDの署名には使っていない
# （セッションIDは randomBytes(32) の乱数そのもの）
SESSION_SECRET=

# 既定モデル
DEFAULT_MODEL=anthropic/claude-opus-5
# 要約・抽出・判定用の軽量モデル
UTILITY_MODEL=anthropic/claude-sonnet-5

PORT=3000
# 待ち受けるインターフェース。未設定なら全インターフェース（0.0.0.0）。
# Tailscale などVPN内だけに公開する場合は 127.0.0.1 にして、
# tailscale serve からループバックへ繋ぐ（先に serve を動かしてから設定すること）
# BIND=127.0.0.1
DB_PATH=./data/app.sqlite
APP_URL=http://localhost:3000
APP_TITLE=Character Chat

# 認証Cookieに secure を付けるか。未設定なら APP_URL が https:// のときだけ有効
# COOKIE_SECURE=1

# リバースプロキシ配下で X-Forwarded-* を信頼する段数（nginx等の背後なら 1）
# TRUST_PROXY=1

# LLMのエンドポイント。既定はOpenRouter。テストでモックに向ける場合のみ設定する
# OPENROUTER_BASE_URL=http://localhost:4010/v1

# ストリームの待ち時間の上限（ミリ秒）。上流が黙り込んだときに生成を打ち切る。
# 接続確立まで / 最後の受信から次の受信まで、をそれぞれ計る
# STREAM_CONNECT_TIMEOUT_MS=60000
# STREAM_IDLE_TIMEOUT_MS=60000

# スナップショット（画像生成）の待ち時間の上限（ミリ秒）。
# 打ち切っても上流で生成が進んでいれば課金され得るので、短くしすぎないこと
# IMAGE_TIMEOUT_MS=120000
